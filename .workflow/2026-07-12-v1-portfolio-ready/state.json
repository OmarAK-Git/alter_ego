{
  "goal": "Finish ALTER_EGO product v1 to honest portfolio-ready bar (SPEC.md Phase 0-4 + SPEC_V3 \u00a77/\u00a79), with hybrid S2 calibration and human drift-research gate before Phase 4.",
  "success_criteria": [
    "All S0-S6 packets done, deferred (with note), or wontfix (with reason) in this state.json",
    "SPEC/README/metrics language agree; no false CALIBRATED or 100% recall",
    "Hybrid S2: integrity fixes, re-sweep, residual documented if needed",
    "HUMAN-DRIFT-RESEARCH acknowledged before any S5 packet starts",
    "verify_run.py green; pytest+ruff pass on sprint/program closeout"
  ],
  "constraints": [
    "Docs source of truth; metrics beat narrative",
    "No weight/threshold change without eval sweep + config governance",
    "Do not commit calibrate/eval DB churn or __pycache__",
    "UAW T3 packets only \u2014 do not install archived gsd-build",
    "One sprint at a time; no shared write-scope parallelism",
    "Non-goals: SIEM, multi-tenant, live ingest, multi-agent detection, real IAM disable"
  ],
  "risks": [
    {
      "risk": "S2 still fails after integrity fixes",
      "approval_required": false,
      "mitigation": "Hybrid C residual note; no fake Phase 2 closed"
    },
    {
      "risk": "Spec forks left silent (cohort, lifecycle, calendar)",
      "approval_required": false,
      "mitigation": "Packet must implement or write explicit downgrade"
    },
    {
      "risk": "Starting S5 before human drift research",
      "approval_required": true,
      "mitigation": "HUMAN-DRIFT-RESEARCH packet blocks S5"
    }
  ],
  "max_concurrent_agents": 1,
  "max_total_agents": 4,
  "active_sprint": "S6",
  "canonical_projections": {
    "progress": "memory-bank/progress.md",
    "tasks": "memory-bank/tasks.md",
    "active_context": "memory-bank/activeContext.md"
  },
  "autopilot": {
    "style": "uaw-t3-gsd-roles",
    "agents": {
      "research": "researcher",
      "implement": "implementer",
      "test": "test-runner",
      "verify": "skeptic-verifier"
    },
    "implementation_model": "composer-2.5",
    "verification_model": "cursor-grok-4.5-high",
    "gate_run_mode": "chat_gate",
    "rules": [
      "Update state.json packet status before memory-bank mirrors",
      "Only mark current sprint packets ready",
      "Block all S5.* until HUMAN-DRIFT-RESEARCH is done",
      "Sprint close / chat_gate reviews: UI-selected Opus; mid-loop verify uses verification_model via Task",
      "Sprint close requires skeptic-verifier + pytest + ruff",
      "Treat S1-EXIT-GATE/S2-EXIT-GATE/S3-EXIT-GATE/S4-EXIT-GATE/S5-EXIT-GATE/S6-EXIT-GATE as chat_gate phase_exit items",
      "With --stop-before-gate, do not start any EXIT-GATE or HUMAN-DRIFT-RESEARCH",
      "Do not mark next sprint ready until previous EXIT-GATE is done"
    ],
    "exit_gates": [
      "S1-EXIT-GATE",
      "S2-EXIT-GATE",
      "S3-EXIT-GATE",
      "S4-EXIT-GATE",
      "HUMAN-DRIFT-RESEARCH",
      "S5-EXIT-GATE",
      "S6-EXIT-GATE"
    ]
  },
